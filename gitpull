#!/bin/bash

case "$1" in
    --pull)
        shift
        # Loop through immediate subdirectories
        for d in */; do
            if [ -d "$d/.git" ]; then
                echo "--- Updating $d ---"
                # -C tells git to run as if it were inside that directory
                git -C "$d" pull "$@"
            fi
        done
        ;;
    --clone)
        shift
        # Define your standard repos here
        REPOS=(
            "brief"
            "circuit"
            "check"
            "aliases"
            "xclone"
            "countd"
            "ftts"
            "mpv3"
            "apex"
            "ytd"
            "pay"
            "pdftompv"
            "hardening"
        )

        mkdir -p ~/Code
        cd ~/Code || exit

        for repo in "${REPOS[@]}"; do
            gh repo clone galaxy-cli/"$repo"
        done
        ;;
    *)
        echo "Usage: gitall --pull [git args] | gitall --clone"
        exit 1
        ;;
esac
